# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings > Data API, and Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). SERVER ONLY. Bypasses RLS. Never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Razorpay (Dashboard > Account & Settings > API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks: the secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (order confirmation email)
RESEND_API_KEY=
# Must be on a domain you have verified in Resend
ORDER_EMAIL_FROM=orders@yourdomain.com

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
